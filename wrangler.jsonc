{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "capitol-twin-cinema",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
